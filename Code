import turtle

def draw_eye(pen, side):
    """Draws one white eye. Use side = -1 for left, side = 1 for right."""
    pen.penup()
    pen.goto(27 * side, -7)
    pen.color("white")
    pen.begin_fill()
    pen.pendown()

    pen.goto(140 * side, 53)
    pen.goto(80 * side, -40)
    pen.goto(67 * side, -37)
    pen.goto(50 * side, -30)
    pen.goto(37 * side, -17)
    pen.goto(27 * side, -7)
    pen.end_fill()

screen = turtle.Screen()
screen.title("Deadpool Logo")
screen.bgcolor("#0D0D0F") 
pen = turtle.Turtle()
pen.speed(0)
pen.hideturtle()

pen.color("#E61A1D")
pen.penup()
pen.goto(0, -200)
pen.pendown()
pen.begin_fill()
pen.circle(200)
pen.end_fill()

pen.color("black")
pen.penup()
pen.goto(0, -170) # 200 - 30 (ring width)
pen.pendown()
pen.begin_fill()
pen.circle(170)
pen.end_fill()

pen.color("#E61A1D")
pen.penup()
pen.goto(-18, 200) # Start at top left of the bar
pen.pendown()
pen.begin_fill()
pen.goto(18, 200)  # Top right
pen.goto(18, -200) # Bottom right
pen.goto(-18, -200)# Bottom left
pen.goto(-18, 200) # Back to start
pen.end_fill()

draw_eye(pen, -1) # Left eye
draw_eye(pen, 1)  # Right eye

screen.exitonclick()

